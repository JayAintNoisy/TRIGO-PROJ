# TriGo Landing Page Environment Configuration
# Copy to .env and adjust. Only VITE_* keys are exposed to the browser bundle.

# Backend REST API base. The origin is derived from this value to reach /health.
VITE_API_BASE_URL=http://localhost:4000/api

# Public download URL of the published Android APK.
# Leave empty until an APK is hosted: the page then shows a disabled button
# plus a short "how to publish" notice instead of a broken link.
VITE_APK_URL=

# Optional display-only download size, e.g. 68 MB. Leave empty to hide the row.
VITE_APK_SIZE=

# Release identity of the build this page advertises.
# Version is shown as-is; the label is optional (demo, beta, rc, ... any text).
# An empty or missing label means production and the version is shown alone:
#   1.0.0-demo  (labelled)      1.0.0  (production)
# Keep these in sync with apps/trigo/.env (APP_RELEASE_VERSION / APP_RELEASE_LABEL).
VITE_APP_VERSION=1.0.0
VITE_APP_RELEASE_LABEL=demo
