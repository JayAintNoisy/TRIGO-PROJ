API_BASE_URL=http://10.0.2.2:4000/api
# Android emulator: 10.0.2.2 maps to host localhost
# Physical device: use your PC LAN IP, e.g. http://192.168.1.100:4000/api
# iOS simulator: http://localhost:4000/api

# Mapbox public token (pk.*) used by the driver application map picker
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here

# Displayed app version. Keep this in sync with the `version:` field in
# pubspec.yaml so the splash screen and Settings show the real build version.
# Absent or blank falls back to 1.0.0.
APP_RELEASE_VERSION=1.0.0

# Optional release channel label (e.g. demo, beta). It is appended verbatim to
# the version as `1.0.0-demo` and rendered as a badge. Leave this out, empty,
# or whitespace-only for a production build, which shows the version alone.
APP_RELEASE_LABEL=demo
