# TriGo Admin Web Environment Configuration
VITE_API_BASE_URL=http://localhost:4000/api

# Public Mapbox token (pk.*) used by the municipality boundary mapper and the
# live tracking map. Optional: when it is missing or blank both maps fall back
# to the public token the panel ships with, so set this only to rotate it.
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
