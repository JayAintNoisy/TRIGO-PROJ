# TriGo Monorepo Master Environment Reference
# Individual environment files live inside each project directory:
# - apps/trigo-backend/.env
# - apps/trigo-admin/.env

# Backend API Service Configuration (apps/trigo-backend/.env)
BACKEND_NODE_ENV=development
BACKEND_PORT=4000
BACKEND_JWT_SECRET=trigo-jwt-secret-key-change-in-production
BACKEND_JWT_REFRESH_SECRET=trigo-jwt-refresh-secret-key-change-in-production
BACKEND_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trigo_db
BACKEND_CORS_ORIGIN=*

# Admin Web App Configuration (apps/trigo-admin/.env)
VITE_API_BASE_URL=http://localhost:4000/api
