# TriGo Monorepo Master Environment Reference
# Individual environment files live inside each project directory:
# - apps/trigo-backend/.env
# - apps/trigo-admin/.env
# - apps/trigo-landing/.env
# - apps/trigo/.env

# Backend API Service Configuration (apps/trigo-backend/.env)
BACKEND_NODE_ENV=development
BACKEND_PORT=4000
BACKEND_JWT_SECRET=trigo-jwt-secret-key-change-in-production
BACKEND_JWT_REFRESH_SECRET=trigo-jwt-refresh-secret-key-change-in-production
BACKEND_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trigo_db
BACKEND_CORS_ORIGIN=*

# Admin Web App Configuration (apps/trigo-admin/.env)
VITE_API_BASE_URL=http://localhost:4000/api

# Landing Page Configuration (apps/trigo-landing/.env)
# VITE_API_BASE_URL       backend REST base; its origin is used for the /health probe
# VITE_APK_URL            public APK download URL; empty means "not published yet"
# VITE_APK_SIZE           optional display-only size, e.g. "68 MB"
# VITE_APP_VERSION        version shown on the page and next to the download button
# VITE_APP_RELEASE_LABEL  optional release text (demo, beta, ...); empty or
#                         missing means production, so only the version shows
LANDING_VITE_API_BASE_URL=http://localhost:4000/api
LANDING_VITE_APK_URL=
LANDING_VITE_APK_SIZE=
LANDING_VITE_APP_VERSION=1.0.0
LANDING_VITE_APP_RELEASE_LABEL=demo

# Mobile App Release Identity (apps/trigo/.env)
# APP_RELEASE_VERSION  keep in step with apps/trigo/pubspec.yaml
# APP_RELEASE_LABEL    optional release text shown in the app (demo, beta, ...);
#                      empty or missing means production: only the version shows
MOBILE_APP_RELEASE_VERSION=1.0.0
MOBILE_APP_RELEASE_LABEL=demo
